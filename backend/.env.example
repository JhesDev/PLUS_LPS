# Copiar a .env y completar con valores del entorno local (`supabase status`).
# NUNCA versionar .env ni claves reales.
# Estas variables son exclusivas del backend: no usar prefijo VITE_ ni exponerlas al cliente.

SUPABASE_URL=http://127.0.0.1:54321
# Preferida para proyectos Supabase actuales; SUPABASE_ANON_KEY sigue aceptada.
SUPABASE_PUBLISHABLE_KEY=<publishable/anon key del entorno local>

# Conexion directa a PostgreSQL (rol de servidor). Necesaria porque el esquema
# `ingest` no se expone por PostgREST. En local: postgresql://postgres:<password>@127.0.0.1:54322/postgres
DATABASE_URL=
# Rol con el que opera la sincronizacion. Dejar vacio para usar el rol del DSN.
DB_SERVICE_ROLE=service_role

SYNC_SOURCE=sap
SYNC_ENTITY=work_order
HTTP_TIMEOUT_SECONDS=10
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
